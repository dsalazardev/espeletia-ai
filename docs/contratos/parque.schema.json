{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dsalazardev/espeletia-ai/docs/contratos/parque.schema.json",
  "title": "Paquete del parque (models/parque.json)",
  "description": "Lo que el equipo enseñó a la Lente y las estaciones fijadas en campo. Lo escriben el Modo equipo (js/ajustes.js → paqueteParque) y herramientas/lente_base.py; todos los teléfonos lo reciben al abrir la app con señal.",
  "type": "object",
  "required": ["tipo", "version", "lente", "estaciones"],
  "properties": {
    "tipo": { "const": "paramo-parque" },
    "version": { "type": "integer", "minimum": 1 },
    "fecha": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "nota": { "type": "string" },
    "lente": {
      "description": "null mientras nadie publique; si no, vectores k-NN cuantizados (ml.codificar).",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["dim", "clases", "vectores", "escalas"],
          "properties": {
            "dim": { "type": "integer", "minimum": 1 },
            "clases": { "type": "array", "items": { "type": "string" } },
            "vectores": { "type": "string", "description": "Int8 en base64, dim × n" },
            "escalas": { "type": "string", "description": "Float32 en base64, n" },
            "cabeza": {
              "description": "Cabeza calibrada (herramientas/lente_base.py): huellas centradas y umbral medido. Sin ella, la app usa camara.umbral/simMin/simOk.",
              "type": "object",
              "required": ["tipo", "centro", "umbral"],
              "properties": {
                "tipo": { "const": "knn-centrado" },
                "k": { "type": "integer", "minimum": 1 },
                "temperatura": { "type": "number", "exclusiveMinimum": 0 },
                "umbral": { "type": "number", "minimum": 0, "maximum": 1 },
                "objetivo": { "type": "number", "minimum": 0, "maximum": 1 },
                "centro": { "type": "string", "description": "Float32 en base64, dim: huella promedio de la base" },
                "curva": { "type": "array", "description": "[votos, acierto medido]: para mostrar una certeza honesta", "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } },
                "medido": { "type": ["object", "null"] }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "estaciones": {
      "description": "Coordenadas fijadas en campo, por id de estación de paquete.json.",
      "type": "object",
      "propertyNames": { "pattern": "^e[0-9]+$" },
      "additionalProperties": {
        "type": "object",
        "required": ["lat", "lon"],
        "properties": {
          "lat": { "type": "number", "minimum": -90, "maximum": 90 },
          "lon": { "type": "number", "minimum": -180, "maximum": 180 },
          "altura": { "type": "number", "minimum": 0, "maximum": 6000 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
